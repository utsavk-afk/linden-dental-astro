---
// Journal post list: the newest post as a large feature, the rest as rows. Same markup and
// styles as src/pages/journal/index.astro; used by the category and tag archives.
import { url } from '../lib/url';
import { getJournalPage, getSettings } from '../lib/cms';
import type { Post } from '../lib/cms';
import Icon from './Icon.astro';
import CmsImage from './CmsImage.astro';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const [page, settings] = await Promise.all([getJournalPage(), getSettings()]);
const [feature, ...rest] = posts;
const featureAuthor = feature ? feature.author?.name || settings.name : '';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Inline editing (EmDash Edit mode), as on the journal page.
const e = page.edit;
const se = settings.edit;
---
{feature && (
<section class="wrap feature-wrap">
  <a class="feature" href={url(`/journal/${feature.id}/`)} data-reveal>
    <div class="frame feature__img" {...feature.edit.featured_image}><CmsImage image={feature.cover} alt={feature.coverAlt} width={1200} height={900} loading="eager" /></div>
    <div class="feature__copy">
      <p class="meta"><span {...feature.edit.category}>{feature.tag}</span> <span aria-hidden="true">/</span> {feature.readMinutes} <span {...se.labels_min_read}>{settings.labels.minRead}</span></p>
      <h2 {...feature.edit.title}>{feature.title}</h2>
      <p class="muted" {...feature.edit.excerpt}>{feature.description}</p>
      <p class="byline"><span {...feature.edit.author}>{featureAuthor}</span>, <span {...feature.edit.publish_date}>{fmt(feature.date)}</span></p>
      <span class="link-arrow"><span {...e.read_label}>{page.readLabel}</span> <Icon name="arrow-right" /></span>
    </div>
  </a>
</section>
)}

{rest.length > 0 && (
<section class="section">
  <div class="wrap">
    <ul class="list">
      {rest.map((p) => (
        <li data-reveal>
          <a href={url(`/journal/${p.id}/`)} class="row">
            <div class="frame row__img" {...p.edit.featured_image}><CmsImage image={p.cover} alt={p.coverAlt} width={480} height={360} /></div>
            <div class="row__copy">
              <p class="meta"><span {...p.edit.category}>{p.tag}</span> <span aria-hidden="true">/</span> {p.readMinutes} <span {...se.labels_min_read}>{settings.labels.minRead}</span></p>
              <h2 {...p.edit.title}>{p.title}</h2>
              <p class="muted" {...p.edit.excerpt}>{p.description}</p>
            </div>
            <p class="row__date" {...p.edit.publish_date}>{fmt(p.date)}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

<style>
  .feature-wrap:last-child { padding-bottom: var(--section); }
  .feature { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); align-items: center; text-decoration: none; }
  .feature__img { aspect-ratio: 4 / 3; }
  .feature__copy { display: grid; gap: 1rem; justify-items: start; }
  .feature h2 { font-size: var(--step-3); transition: color 0.3s; }
  .feature:hover h2 { color: var(--accent); }
  .feature__img :global(img), .row__img :global(img) { transition: transform 0.9s var(--ease-out); }
  .feature:hover .feature__img :global(img), .row:hover .row__img :global(img) { transform: scale(1.04); }
  .meta { font-size: var(--step--1); font-weight: 600; color: var(--accent); }
  .meta [aria-hidden] { color: var(--line); margin-inline: 0.3em; } /* the "/" divider, not the edit-mode field spans */
  .byline { font-size: var(--step--1); color: var(--ink-2); }
  .list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; gap: clamp(1rem, 0.5rem + 2vw, 2.5rem); align-items: center; padding-block: 1.75rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .row__img { aspect-ratio: 4 / 3; border-radius: var(--r-md); }
  .row__copy { display: grid; gap: 0.5rem; }
  .row h2 { font-size: var(--step-2); transition: color 0.3s; }
  .row:hover h2 { color: var(--accent); }
  .row__date { color: var(--ink-2); font-size: var(--step--1); white-space: nowrap; align-self: start; }
  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .row { grid-template-columns: 120px 1fr; }
    .row__date { display: none; }
  }
</style>
