---
// The "footer" widget area (admin > Widgets > Footer notes): short notes such as the emergency
// line, shown in the footer of every page. Same output as emdash/ui's <WidgetArea name="footer" />
// (wrapper classes and data attributes included), but content widgets render through RichText and
// menu links through href(), so site links get the staging prefix (WidgetArea's built-in renderer
// writes them unprefixed). Component widgets (core:recent-posts etc.) are not used here.
import { getWidgets } from '../lib/cms';
import { href } from '../lib/url';
import RichText from './RichText.astro';

interface Props {
  area?: string;
  class?: string;
}

const { area = 'footer', class: className } = Astro.props;
const widgets = (await getWidgets(area)).filter((w) => w.title || w.content.length || w.menu.length);
---
{widgets.length > 0 && (
  <div class:list={['widget-area', 'footer-widgets', className]} data-widget-area={area}>
    {widgets.map((w) => (
      <div class="widget" data-widget-id={w.id} data-widget-type={w.type}>
        {w.title && <h2 class="widget__title">{w.title}</h2>}
        <div class="widget__content">
          {w.type === 'content' && <RichText value={w.content} />}
          {w.type === 'menu' && (
            <ul class="widget__menu">
              {w.menu.map((l) => <li><a href={href(l.link)}>{l.label}</a></li>)}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .footer-widgets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1rem; margin-top: 3rem; }
  .widget { display: grid; gap: 0.4rem; padding: 1.25rem 1.5rem; border-radius: var(--r-md); background: var(--bloom); color: var(--bloom-ink); }
  .widget__title { font-family: var(--font-text); font-size: var(--step-0); font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  .widget__content { display: grid; gap: 0.35rem; font-size: var(--step--1); }
  .widget__content :global(a) { color: inherit; font-weight: 600; }
  .widget__menu { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  /* touch: menu links get a 44px row, like the footer links (links inside sentences stay inline) */
  @media (max-width: 860px), (pointer: coarse) {
    .widget__menu a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
