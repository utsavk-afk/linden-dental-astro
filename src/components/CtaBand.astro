---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; body?: string }
// Default wording comes from Site settings > Call to action band; pages can pass their own.
// An empty override (field cleared in the CMS) also falls back to the default.
const title = Astro.props.title || site.ctaBand.title;
const body = Astro.props.body || site.ctaBand.text;
---
<section class="band">
  <div class="wrap band__inner">
    <h2 data-split>{title}</h2>
    <p class="lede" data-reveal>{body}</p>
    <div class="band__actions" data-reveal>
      <a class="btn btn--lg" href={site.cta.href}>{site.cta.label} <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost btn--lg" href={site.phoneHref}><Icon name="phone" /> {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .band { padding-block: var(--section); }
  .band__inner {
    --band-bg: var(--accent); --band-fg: var(--on-accent); --band-btn: var(--on-accent); --band-btn-fg: var(--accent); --band-btn-hover: var(--bg);
    background: var(--band-bg); color: var(--band-fg); border-radius: var(--r-lg);
    padding: clamp(2.5rem, 1.5rem + 5vw, 6rem); display: grid; gap: 1.5rem; justify-items: start;
  }
  /* dark: a full mint slab glares on the night page, so the panel goes deep green and the pills return to normal accent */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .band__inner { --band-bg: color-mix(in oklab, var(--accent) 14%, var(--surface)); --band-fg: var(--ink); --band-btn: var(--accent); --band-btn-fg: var(--on-accent); --band-btn-hover: var(--accent-hover); }
  }
  :global(:root[data-theme='dark']) .band__inner { --band-bg: color-mix(in oklab, var(--accent) 14%, var(--surface)); --band-fg: var(--ink); --band-btn: var(--accent); --band-btn-fg: var(--on-accent); --band-btn-hover: var(--accent-hover); }
  .band h2 { max-width: 16ch; }
  .band .lede { color: color-mix(in oklab, var(--band-fg) 80%, transparent); }
  .band__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .band .btn { --_bg: var(--band-btn); --_fg: var(--band-btn-fg); --_bd: var(--band-btn); }
  .band .btn:hover { --_bg: var(--band-btn-hover); --_bd: var(--band-btn-hover); }
  .band .btn--ghost { --_bg: transparent; --_fg: var(--band-fg); --_bd: color-mix(in oklab, var(--band-fg) 45%, transparent); }
  .band .btn--ghost:hover { --_bg: color-mix(in oklab, var(--band-fg) 12%, transparent); --_bd: var(--band-fg); }
  /* phones: stacked pills share one width instead of two ragged ones */
  @media (max-width: 560px) {
    .band__inner { justify-items: stretch; }
    .band__actions .btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
