---
// Comments under a journal post: EmDash's Comments (approved comments, threaded so team replies
// sit under the question) and CommentForm (posts to /_emdash/api/comments/journal/<row id>).
// New comments wait in the admin under Comments until approved (moderation "first time": a
// commenter's first comment is held, later ones from the same email go straight up). Renders
// nothing when comments are switched off for the Journal collection.
import { Comments, CommentForm } from 'emdash/ui/comments';
import { getCollectionInfo } from 'emdash';
import { getPostExtras } from '../lib/cms';

interface Props {
  /** The post slug (Post.id). Comments are stored against the post's EmDash row id. */
  slug: string;
  title?: string;
  intro?: string;
}

const {
  slug,
  title = 'Questions and comments',
  intro = 'Ask us anything about this post. We read every comment before it goes up, so please keep personal health details out of it and call us for anything about your own teeth.',
} = Astro.props;
const [info, extras] = await Promise.all([
  getCollectionInfo('journal').catch(() => null),
  getPostExtras(slug, { includeDrafts: !!import.meta.env.PUBLIC_SHOW_DRAFTS }),
]);
const enabled = !!info?.commentsEnabled && !!extras;
---
{enabled && extras && (
  <section class="post-comments" aria-labelledby="comments-title">
    <div class="wrap post-comments__inner">
      <header class="post-comments__head">
        <h2 id="comments-title">{title}</h2>
        <p class="muted">{intro}</p>
      </header>
      <Comments
        collection="journal"
        contentId={extras.rowId}
        threaded
        locale="en-US"
        labels={{
          heading: (count) => (count === 0 ? 'No comments yet' : count === 1 ? '1 comment' : `${count} comments`),
          member: 'Linden team',
        }}
      />
      <div class="post-comments__form">
        <h3>Leave a comment</h3>
        <CommentForm
          collection="journal"
          contentId={extras.rowId}
          labels={{
            name: 'Your name',
            email: 'Email (never shown)',
            comment: 'Your comment or question',
            submit: 'Post comment',
            submitting: 'Sending...',
            published: 'Thanks, your comment is up. Refresh the page to see it.',
            pending: 'Thanks. We read every comment before it appears, so yours will show up soon.',
            networkError: 'That did not send. Check your connection and try again.',
          }}
        />
      </div>
    </div>
  </section>
)}

<style>
  .post-comments { border-top: 1px solid var(--line); padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .post-comments__inner { display: grid; gap: 2.5rem; max-width: 820px; margin-inline: auto; }
  .post-comments__head { display: grid; gap: 0.75rem; }
  .post-comments__head h2 { font-size: var(--step-3); }
  .post-comments__form { display: grid; gap: 1.25rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); background: var(--surface); border-radius: var(--r-lg); box-shadow: var(--shadow); }
  .post-comments__form h3 { font-size: var(--step-2); }

  /* EmDash comment list */
  .post-comments :global(.ec-comments) { --ec-comment-gap: 1.5rem; --ec-comment-indent: 1.5rem; --ec-comment-border: 1px solid var(--line); }
  .post-comments :global(.ec-comments-heading) { font-family: var(--font-text); font-size: var(--step--1); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 1.25rem; }
  .post-comments :global(.ec-comments-list) { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .post-comments :global(.ec-comment-author) { color: var(--ink); }
  .post-comments :global(.ec-comment-badge) { color: var(--accent); }
  .post-comments :global(.ec-comment-date) { color: var(--ink-2); opacity: 1; font-size: var(--step--1); }
  .post-comments :global(.ec-comment-body) { color: var(--ink); line-height: 1.6; }
  .post-comments :global(.ec-comment-body a) { color: var(--accent); }
  .post-comments :global(.ec-comment-replies) { border-left: 2px solid var(--bg-2); }

  /* EmDash comment form, in the booking form's style. Outlines keep 3:1 against the panel. */
  .post-comments :global(.ec-comment-form) { --field-line: color-mix(in oklab, var(--ink-2) 72%, var(--surface)); --ec-form-gap: 1.1rem; }
  .post-comments :global(.ec-comment-form-field span) { font-weight: 600; }
  .post-comments :global(.ec-comment-form-field input),
  .post-comments :global(.ec-comment-form-field textarea) {
    padding: 0.85rem 1.1rem; border: 1px solid var(--field-line); border-radius: var(--pill);
    background: var(--bg); color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s;
  }
  .post-comments :global(.ec-comment-form-field textarea) { border-radius: var(--r-md); resize: vertical; }
  .post-comments :global(.ec-comment-form-field input:focus),
  .post-comments :global(.ec-comment-form-field textarea:focus) { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 25%, transparent); }
  .post-comments :global(.ec-comment-user-info) { background: var(--bg-2); border-color: var(--line); border-radius: var(--r-md); color: var(--ink); }
  .post-comments :global(.ec-comment-form-submit) {
    display: inline-flex; align-items: center; padding: 0.85em 1.4em; border-radius: var(--pill); border: 1px solid var(--accent);
    background: var(--accent); color: var(--on-accent); font-weight: 600; line-height: 1; margin-top: 1.25rem;
    transition: background-color 0.25s var(--ease-out), border-color 0.25s;
  }
  .post-comments :global(.ec-comment-form-submit:hover) { background: var(--accent-hover); border-color: var(--accent-hover); }
  .post-comments :global(.ec-comment-form-status) { font-size: var(--step--1); font-weight: 600; }
  .post-comments :global(.ec-comment-form-success) { color: var(--accent); }
  .post-comments :global(.ec-comment-form-error) { color: var(--danger); }
</style>
