---
import { url, publicPath } from '../lib/url';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../data/site';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CmsImage } from '../lib/cms';
import defaultShare from '../assets/photos/hero-family.jpg';
import { dentistSchema } from '../lib/seo';

// SEO: every page passes its own title/description (editable in the CMS); the rest has defaults.
interface Props {
  title?: string;           // page title; the site suffix is added unless it already names the practice
  description?: string;
  image?: ImageMetadata | CmsImage | null; // social share image: a local asset is cropped to 1200x630, a CMS image is used as uploaded
  type?: 'website' | 'article';
  jsonLd?: (Record<string, unknown> | null)[];
  progress?: boolean;
}
const { title, description, image, type = 'website', jsonLd = [], progress = false } = Astro.props;
const site = await getSite();
const { settings } = site;
const metaDescription = description || settings.seoDefaultDescription;
const fullTitle = !title
  ? settings.seoDefaultTitle || site.name
  : title.includes(site.name) ? title : `${title} ${settings.seoTitleSuffix}`.trim();
const canonical = new URL(publicPath(Astro.url.pathname), Astro.site);
const siteUrl = new URL(url('/'), Astro.site).href;
// A CMS image (EmDash media, served from the server root) carries `alt`; a local asset carries `format`.
const isCmsImage = (img: ImageMetadata | CmsImage): img is CmsImage => !('format' in img);
let shareUrl: string;
let shareSize: { width?: number; height?: number } = { width: 1200, height: 630 };
if (image?.src && isCmsImage(image)) {
  shareUrl = new URL(image.src, Astro.site).href;
  shareSize = { width: image.width, height: image.height };
} else {
  const local = image && !isCmsImage(image) ? image : defaultShare;
  const share = await getImage({ src: local, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  shareUrl = new URL(share.src, Astro.site).href;
}
const schemas = [dentistSchema(siteUrl, shareUrl, settings), ...jsonLd].filter(Boolean);
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {import.meta.env.PUBLIC_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareUrl} />
    {shareSize.width && <meta property="og:image:width" content={String(shareSize.width)} />}
    {shareSize.height && <meta property="og:image:height" content={String(shareSize.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={shareUrl} />
    {settings.twitterHandle && <meta name="twitter:site" content={settings.twitterHandle} />}
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('/rss.xml')} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <meta name="theme-color" content="#f3f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1612" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Theme + motion flags before first paint. `.motion` pre-hides reveal targets;
      // it is removed again if the motion module never reports ready.
      (function () {
        var d = document.documentElement;
        try { var t = localStorage.getItem('linden-theme'); if (t) d.dataset.theme = t; } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          d.classList.add('motion');
          setTimeout(function () { if (!window.__motionReady) d.classList.remove('motion'); }, 3000);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">{site.labels.skipLink}</a>
    <Nav />
    {progress && <div class="progress" data-progress aria-hidden="true"></div>}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion, destroyMotion } from '../scripts/motion';
      import { initUI, applyStoredTheme } from '../scripts/ui';
      document.addEventListener('astro:page-load', () => { initUI(); initMotion(); });
      document.addEventListener('astro:before-swap', destroyMotion);
      document.addEventListener('astro:after-swap', () => {
        applyStoredTheme();
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('motion');
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: var(--z-skip);
    background: var(--accent); color: var(--on-accent); padding: 0.75rem 1.1rem; border-radius: var(--pill); font-weight: 600;
  }
  .skip:focus { top: 1rem; }
  .progress {
    position: fixed; inset: 0 0 auto 0; height: 3px; z-index: calc(var(--z-nav) + 1);
    background: var(--accent); transform-origin: 0 50%; transform: scaleX(0);
  }
</style>
