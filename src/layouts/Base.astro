---
import { url, publicPath } from '../lib/url';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../data/site';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CmsImage } from '../lib/cms';
import defaultShare from '../assets/photos/hero-family.jpg';
import { dentistSchema } from '../lib/seo';
import { getEntryRef, SEARCH_COLLECTIONS } from '../lib/cms';
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from 'emdash/ui';
import WebMcpSearch from 'emdash/ui/webmcp-search';
import { createPublicPageContext } from 'emdash/page';

// SEO: every page passes its own title/description (editable in the CMS); the rest has defaults.
interface Props {
  title?: string;           // page title; the site suffix is added unless it already names the practice
  description?: string;
  image?: ImageMetadata | CmsImage | null; // social share image: a local asset is cropped to 1200x630, a CMS image is used as uploaded
  type?: 'website' | 'article';
  jsonLd?: (Record<string, unknown> | null)[];
  progress?: boolean;
  noindex?: boolean;        // e.g. search results
  /** The CMS entry this page renders. Detected for /journal/<slug>/ and /services/<slug>/. */
  content?: { collection: string; slug: string };
}
const { title, description, image, type = 'website', jsonLd = [], progress = false, noindex = false } = Astro.props;
const site = await getSite();
const { settings } = site;
const metaDescription = description || settings.seoDefaultDescription;
const fullTitle = !title
  ? settings.seoDefaultTitle || site.name
  : title.includes(site.name) ? title : `${title} ${settings.seoTitleSuffix}`.trim();
const canonical = new URL(publicPath(Astro.url.pathname), Astro.site);
const siteUrl = new URL(url('/'), Astro.site).href;
// A CMS image (EmDash media, served from the server root) carries `alt`; a local asset carries `format`.
const isCmsImage = (img: ImageMetadata | CmsImage): img is CmsImage => !('format' in img);
let shareUrl: string;
let shareSize: { width?: number; height?: number } = { width: 1200, height: 630 };
if (image?.src && isCmsImage(image)) {
  shareUrl = new URL(image.src, Astro.site).href;
  shareSize = { width: image.width, height: image.height };
} else {
  const local = image && !isCmsImage(image) ? image : defaultShare;
  const share = await getImage({ src: local, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  shareUrl = new URL(share.src, Astro.site).href;
}
// EmDash head/body hooks. EmDashHead writes description, robots, canonical, Open Graph, Twitter
// and the primary JSON-LD graph (BlogPosting on articles), after overlaying the entry's SEO panel
// (meta description, share image, canonical, noindex), plus whatever plugins contribute; this
// layout keeps <title>, og:locale, image size, twitter:site and its own JSON-LD. An Article graph
// passed in jsonLd feeds the article dates/author instead, so posts carry one article graph.
const detail = Astro.props.content ?? (() => {
  const m = Astro.url.pathname.match(/^\/(journal|services)\/([^/]+)\/?$/);
  return m ? { collection: m[1], slug: decodeURIComponent(m[2]) } : undefined;
})();
const ref = detail ? await getEntryRef(detail.collection, detail.slug) : null;
const isArticle = (s: Record<string, unknown> | null) => s?.['@type'] === 'Article';
const article = type === 'article' ? (jsonLd.find(isArticle) as Record<string, unknown> | undefined) : undefined;
const articleAuthor = (article?.author as { name?: string } | undefined)?.name;
const robots = import.meta.env.PUBLIC_NOINDEX || noindex ? 'noindex, nofollow' : null;
const pageContext = createPublicPageContext({
  Astro,
  kind: ref ? 'content' : 'custom',
  pageType: type,
  title: fullTitle,
  description: metaDescription,
  canonical: canonical.href,
  image: shareUrl,
  siteName: site.name,
  siteUrl,
  seo: { robots },
  ...(ref ? { content: { collection: ref.collection, id: ref.id, slug: ref.slug } } : {}),
  ...(article ? { articleMeta: { publishedTime: String(article.datePublished ?? ''), modifiedTime: String(article.dateModified ?? ''), author: articleAuthor ?? null } } : {}),
});
const showShareSize = !ref?.hasSeoImage; // a share image set in the SEO panel has its own size
const schemas = [dentistSchema(siteUrl, shareUrl, settings), ...jsonLd.filter((s) => !(article && s === article))].filter(Boolean);
const searchRoutes = { journal: url('/journal/:slug/'), services: url('/services/:slug/') };
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <EmDashHead page={pageContext} />
    <meta property="og:locale" content="en_US" />
    {showShareSize && shareSize.width && <meta property="og:image:width" content={String(shareSize.width)} />}
    {showShareSize && shareSize.height && <meta property="og:image:height" content={String(shareSize.height)} />}
    {settings.twitterHandle && <meta name="twitter:site" content={settings.twitterHandle} />}
    <link rel="sitemap" href={url('/sitemap.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('/rss.xml')} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <meta name="theme-color" content="#f3f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1612" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Theme + motion flags before first paint. `.motion` pre-hides reveal targets;
      // it is removed again if the motion module never reports ready.
      (function () {
        var d = document.documentElement;
        try { var t = localStorage.getItem('linden-theme'); if (t) d.dataset.theme = t; } catch (e) {}
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
          d.classList.add('motion');
          setTimeout(function () { if (!window.__motionReady) d.classList.remove('motion'); }, 3000);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <EmDashBodyStart page={pageContext} />
    <a class="skip" href="#main">{site.labels.skipLink}</a>
    <Nav />
    {progress && <div class="progress" data-progress aria-hidden="true"></div>}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WebMcpSearch collections={SEARCH_COLLECTIONS} routeMap={searchRoutes} />
    <EmDashBodyEnd page={pageContext} />

    <script>
      import { initMotion, destroyMotion } from '../scripts/motion';
      import { initUI, applyStoredTheme } from '../scripts/ui';
      document.addEventListener('astro:page-load', () => { initUI(); initMotion(); });
      document.addEventListener('astro:before-swap', destroyMotion);
      document.addEventListener('astro:after-swap', () => {
        applyStoredTheme();
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('motion');
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: 1rem; top: -4rem; z-index: var(--z-skip);
    background: var(--accent); color: var(--on-accent); padding: 0.75rem 1.1rem; border-radius: var(--pill); font-weight: 600;
  }
  .skip:focus { top: 1rem; }
  .progress {
    position: fixed; inset: 0 0 auto 0; height: 3px; z-index: calc(var(--z-nav) + 1);
    background: var(--accent); transform-origin: 0 50%; transform: scaleX(0);
  }
</style>
