---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found">
  <section class="nf">
    <div class="wrap">
      <h1>This page has gone missing.</h1>
      <p class="lede">The link may be old, or the page may have moved. The rest of the site is still here.</p>
      <div class="nf__actions">
        <a class="btn btn--lg" href={url('/')}>Back to home <Icon name="arrow-right" /></a>
        <a class="link-arrow" href={url('/services/')}>See our services <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 2rem + 10vw, 12rem); }
  .nf h1 { font-size: var(--step-5); max-width: 13ch; }
  .nf .lede { margin-top: 1.25rem; }
  .nf__actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
</style>
