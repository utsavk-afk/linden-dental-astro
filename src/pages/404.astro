---
import { href } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getNotFoundPage } from '../lib/cms';

// Server output: Astro renders this page on demand (status 404) for every unmatched route.
export const prerender = false;

const page = await getNotFoundPage();
const e = page.edit; // inline-edit annotations (EmDash Edit mode)
---
<Base title={page.pageTitle || page.title}>
  <section class="nf">
    <div class="wrap">
      <h1 {...e.title}>{page.title}</h1>
      {page.lede && <p class="lede" {...e.lede}>{page.lede}</p>}
      <div class="nf__actions">
        {page.primary.label && <a class="btn btn--lg" href={href(page.primary.link)}><span {...e.primary_label}>{page.primary.label}</span> <Icon name="arrow-right" /></a>}
        {page.secondary.label && <a class="link-arrow" href={href(page.secondary.link)}><span {...e.secondary_label}>{page.secondary.label}</span> <Icon name="arrow-right" /></a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(4rem, 2rem + 10vw, 12rem); }
  .nf h1 { font-size: var(--step-5); max-width: 13ch; }
  .nf .lede { margin-top: 1.25rem; }
  .nf__actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
</style>
