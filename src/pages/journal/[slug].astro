---
import { url } from '../../lib/url';
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import { getPosts, readMinutes, formatDate as fmt } from '../../lib/journal';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { journalPage as page, settings } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, next: posts.filter((p) => p.id !== entry.id).slice(0, 2) } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const author = await getEntry(p.author);
const authorName = author?.data.name || settings.name;
const t = page.post;
const siteUrl = new URL(url('/'), Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = [
  articleSchema({ updated: p.updatedDate, title: p.title, description: p.seoDescription || p.description, url: pageUrl, image: new URL(p.cover.src, Astro.site).href, date: p.date, author: authorName, siteUrl }),
  breadcrumbSchema([{ name: 'Home', url: siteUrl }, { name: page.title, url: new URL(url('/journal/'), Astro.site).href }, { name: p.title, url: pageUrl }]),
];
---
<Base title={p.seoTitle || p.title} description={p.seoDescription || p.description} image={p.cover} type="article" jsonLd={jsonLd} progress>
  <article data-article>
    {p.draft && <p class="draft-banner" role="note">{page.post.draftBanner}</p>}
    <header class="wrap head">
      <a class="back" href={url('/journal/')}><Icon name="arrow-left" /> {t.backLabel}</a>
      <p class="meta" data-reveal>{p.tag} <span aria-hidden="true">/</span> {readMinutes(entry)} {settings.labels.minRead}</p>
      <h1 data-split>{p.title}</h1>
      <p class="lede" data-reveal>{p.description}</p>
      <p class="byline" data-reveal>{authorName}, <time datetime={p.date.toISOString()}>{fmt(p.date)}</time>{p.updatedDate && <> <span aria-hidden="true">/</span> {page.post.updatedLabel} <time datetime={p.updatedDate.toISOString()}>{fmt(p.updatedDate)}</time></>}</p>
    </header>
    <div class="wrap">
      <div class="frame cover" data-parallax="5"><Image src={p.cover} alt={p.coverAlt} layout="full-width" loading="eager" /></div>
    </div>
    <div class="wrap body">
      <div class="prose"><Content /></div>
      {author && (
        <aside class="author">
          <div class="frame author__img"><Image src={author.data.photo} alt="" width={160} height={160} /></div>
          <div><strong>{author.data.name}</strong><p class="muted">{t.authorLine.replace('{role}', author.data.role)} {author.data.bio.split('. ')[0].replace(/\.$/, '')}.</p></div>
        </aside>
      )}
    </div>
  </article>

  <section class="section next">
    <div class="wrap">
      <h2 class="next__title">{t.nextTitle}</h2>
      <div class="next__grid">
        {next.map((n) => (
          <a class="next__item" href={url(`/journal/${n.id}/`)} data-reveal>
            <div class="frame next__img"><Image src={n.data.cover} alt={n.data.coverAlt} width={720} height={480} /></div>
            <p class="meta">{n.data.tag}</p>
            <h3>{n.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={t.ctaTitle || undefined} body={t.ctaText || undefined} />
</Base>

<style>
  .draft-banner { background: var(--bloom); color: var(--bloom-ink); text-align: center; font-weight: 600; padding: 0.6rem var(--gutter); }
  .head { padding-block: clamp(1.5rem, 1rem + 3vw, 4rem) clamp(2rem, 1rem + 3vw, 3.5rem); display: grid; gap: 1rem; justify-items: start; max-width: 980px; }
  .back { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; text-decoration: none; color: var(--ink-2); font-weight: 500; margin-bottom: 0.5rem; }
  .head h1 { font-size: var(--step-4); }
  .meta { font-size: var(--step--1); font-weight: 600; color: var(--accent); }
  .meta span { color: var(--line); margin-inline: 0.3em; }
  .byline { color: var(--ink-2); font-size: var(--step--1); }
  .cover { height: clamp(280px, 50vw, 600px); }
  .body { display: grid; grid-template-columns: minmax(0, 68ch) minmax(0, 280px); justify-content: space-between; gap: 3rem; padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem); }
  .prose { font-size: var(--step-1); line-height: 1.65; }
  .prose :global(p) { margin-bottom: 1.25em; }
  .prose :global(h2) { font-size: var(--step-2); margin: 2em 0 0.6em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .author { position: sticky; top: 7rem; align-self: start; display: grid; gap: 1rem; padding: 1.5rem; background: var(--bg-2); border-radius: var(--r-md); font-size: var(--step--1); }
  .author__img { width: 64px; height: 64px; border-radius: var(--pill); }
  .author .muted { margin-top: 0.35rem; }
  .next { border-top: 1px solid var(--line); }
  .next__title { font-size: var(--step-3); margin-bottom: 2rem; }
  .next__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 1rem + 2vw, 3rem); }
  .next__item { text-decoration: none; display: grid; gap: 0.75rem; }
  .next__img { aspect-ratio: 3 / 2; }
  .next__item h3 { transition: color 0.3s; }
  .next__item:hover h3 { color: var(--accent); }
  @media (max-width: 860px) {
    .body { grid-template-columns: 1fr; }
    .author { position: static; grid-template-columns: 64px 1fr; align-items: center; }
    .next__grid { grid-template-columns: 1fr; }
  }
</style>
