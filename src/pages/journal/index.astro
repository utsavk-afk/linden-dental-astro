---
import { url } from '../../lib/url';
import { getPosts, getJournalPage, getSettings } from '../../lib/cms';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CmsImage from '../../components/CmsImage.astro';

// Staging (PUBLIC_SHOW_DRAFTS) lists drafts so editors can preview them; production does not.
const [posts, page, settings] = await Promise.all([
  getPosts({ includeDrafts: !!import.meta.env.PUBLIC_SHOW_DRAFTS }),
  getJournalPage(),
  getSettings(),
]);
const [feature, ...rest] = posts;
const featureAuthor = feature ? feature.author?.name || settings.name : '';
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={page.seo.title || page.title} description={page.seo.description || undefined}>
  <section class="head">
    <div class="wrap">
      <h1 data-split>{page.title}</h1>
      {page.lede && <p class="lede" data-reveal>{page.lede}</p>}
    </div>
  </section>

  {feature && (
  <section class="wrap feature-wrap">
    <a class="feature" href={url(`/journal/${feature.id}/`)} data-reveal>
      <div class="frame feature__img"><CmsImage image={feature.cover} alt={feature.coverAlt} width={1200} height={900} loading="eager" /></div>
      <div class="feature__copy">
        <p class="meta">{feature.tag} <span aria-hidden="true">/</span> {feature.readMinutes} {settings.labels.minRead}</p>
        <h2>{feature.title}</h2>
        <p class="muted">{feature.description}</p>
        <p class="byline">{featureAuthor}, {fmt(feature.date)}</p>
        <span class="link-arrow">{page.readLabel} <Icon name="arrow-right" /></span>
      </div>
    </a>
  </section>
  )}

  <section class="section">
    <div class="wrap">
      <ul class="list">
        {rest.map((p) => (
          <li data-reveal>
            <a href={url(`/journal/${p.id}/`)} class="row">
              <div class="frame row__img"><CmsImage image={p.cover} alt={p.coverAlt} width={480} height={360} /></div>
              <div class="row__copy">
                <p class="meta">{p.tag} <span aria-hidden="true">/</span> {p.readMinutes} {settings.labels.minRead}</p>
                <h2>{p.title}</h2>
                <p class="muted">{p.description}</p>
              </div>
              <p class="row__date">{fmt(p.date)}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 4rem); }
  .head .lede { margin-top: 1.25rem; }
  .feature { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); align-items: center; text-decoration: none; }
  .feature__img { aspect-ratio: 4 / 3; }
  .feature__copy { display: grid; gap: 1rem; justify-items: start; }
  .feature h2 { font-size: var(--step-3); transition: color 0.3s; }
  .feature:hover h2 { color: var(--accent); }
  .feature__img :global(img), .row__img :global(img) { transition: transform 0.9s var(--ease-out); }
  .feature:hover .feature__img :global(img), .row:hover .row__img :global(img) { transform: scale(1.04); }
  .meta { font-size: var(--step--1); font-weight: 600; color: var(--accent); }
  .meta span { color: var(--line); margin-inline: 0.3em; }
  .byline { font-size: var(--step--1); color: var(--ink-2); }
  .list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; gap: clamp(1rem, 0.5rem + 2vw, 2.5rem); align-items: center; padding-block: 1.75rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .row__img { aspect-ratio: 4 / 3; border-radius: var(--r-md); }
  .row__copy { display: grid; gap: 0.5rem; }
  .row h2 { font-size: var(--step-2); transition: color 0.3s; }
  .row:hover h2 { color: var(--accent); }
  .row__date { color: var(--ink-2); font-size: var(--step--1); white-space: nowrap; align-self: start; }
  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .row { grid-template-columns: 120px 1fr; }
    .row__date { display: none; }
  }
</style>
