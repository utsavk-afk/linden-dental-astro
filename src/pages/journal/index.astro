---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('journal')).sort((a, b) => +b.data.date - +a.data.date);
const [feature, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Journal" description="Plain answers to the questions patients ask us most: costs, kids’ visits, flossing and more.">
  <section class="head">
    <div class="wrap">
      <h1 data-split>Journal</h1>
      <p class="lede" data-reveal>Plain answers to the questions we hear most, written by the people who answer them in the chair.</p>
    </div>
  </section>

  <section class="wrap feature-wrap">
    <a class="feature" href={`/journal/${feature.id}/`} data-reveal>
      <div class="frame feature__img"><Image src={feature.data.cover} alt={feature.data.coverAlt} width={1200} height={900} loading="eager" /></div>
      <div class="feature__copy">
        <p class="meta">{feature.data.tag} <span aria-hidden="true">/</span> {feature.data.readMinutes} min read</p>
        <h2>{feature.data.title}</h2>
        <p class="muted">{feature.data.description}</p>
        <p class="byline">{feature.data.author}, {fmt(feature.data.date)}</p>
        <span class="link-arrow">Read it <Icon name="arrow-right" /></span>
      </div>
    </a>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="list">
        {rest.map((p) => (
          <li data-reveal>
            <a href={`/journal/${p.id}/`} class="row">
              <div class="frame row__img"><Image src={p.data.cover} alt={p.data.coverAlt} width={480} height={360} /></div>
              <div class="row__copy">
                <p class="meta">{p.data.tag} <span aria-hidden="true">/</span> {p.data.readMinutes} min read</p>
                <h2>{p.data.title}</h2>
                <p class="muted">{p.data.description}</p>
              </div>
              <p class="row__date">{fmt(p.data.date)}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 4rem); }
  .head .lede { margin-top: 1.25rem; }
  .feature { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(1.5rem, 1rem + 3vw, 4rem); align-items: center; text-decoration: none; }
  .feature__img { aspect-ratio: 4 / 3; }
  .feature__copy { display: grid; gap: 1rem; justify-items: start; }
  .feature h2 { font-size: var(--step-3); transition: color 0.3s; }
  .feature:hover h2 { color: var(--accent); }
  .feature__img :global(img), .row__img :global(img) { transition: transform 0.9s var(--ease-out); }
  .feature:hover .feature__img :global(img), .row:hover .row__img :global(img) { transform: scale(1.04); }
  .meta { font-size: var(--step--1); font-weight: 600; color: var(--accent); }
  .meta span { color: var(--line); margin-inline: 0.3em; }
  .byline { font-size: var(--step--1); color: var(--ink-2); }
  .list { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 220px minmax(0, 1fr) auto; gap: clamp(1rem, 0.5rem + 2vw, 2.5rem); align-items: center; padding-block: 1.75rem; border-bottom: 1px solid var(--line); text-decoration: none; }
  .row__img { aspect-ratio: 4 / 3; border-radius: var(--r-md); }
  .row__copy { display: grid; gap: 0.5rem; }
  .row h2 { font-size: var(--step-2); transition: color 0.3s; }
  .row:hover h2 { color: var(--accent); }
  .row__date { color: var(--ink-2); font-size: var(--step--1); white-space: nowrap; align-self: start; }
  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .row { grid-template-columns: 120px 1fr; }
    .row__date { display: none; }
  }
</style>
