---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { palette } from '../data/design';
import { designPage as page } from '../lib/content';

// Hex values come from code; each colour's name and use text come from the CMS, matched by token.
const swatches = palette.map((c) => {
  const words = page.colour.swatches.find((s) => s.token === c.token);
  return { ...c, name: words?.name || c.token.slice(2), use: words?.use || '' };
});
const { principles, colour, type, components, motion, inspiration } = page;
---
<Base title={page.seo.title || page.title} description={page.seo.description || undefined}>
  <section class="head">
    <div class="wrap">
      <h1 data-split>{page.title}</h1>
      {page.lede && <p class="lede" data-reveal>{page.lede}</p>}
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{principles.title}</h2>
      <ul class="principles">
        {principles.items.map((p) => (
          <li data-reveal><h3>{p.title}</h3><p class="muted">{p.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{colour.title}</h2>
      {colour.intro && <p class="muted measure">{colour.intro}</p>}
      <div class="swatches">
        {swatches.map((c) => (
          <div class="swatch" data-reveal>
            <div class="swatch__chips"><span style={`background:${c.light}`}></span><span style={`background:${c.dark}`}></span></div>
            <strong>{c.name}</strong>
            <code>{c.token.slice(2)}</code>
            <span class="muted swatch__hex">{c.light} / {c.dark}</span>
            {c.use && <p class="muted">{c.use}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{type.title}</h2>
      {type.intro && <p class="muted measure">{type.intro}</p>}
      <div class="specimen">
        {type.specimens.map((s) => (
          <div class="specimen__row" data-reveal>
            <span class="specimen__meta"><strong>{s.label}</strong><code>{s.step.slice(2)}</code></span>
            <span class={s.step === '--step-0' || s.step === '--step-1' ? 'specimen__text specimen__text--body' : 'specimen__text'} style={`font-size:var(${s.step})`}>{s.sample}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{components.title}</h2>
      {components.intro && <p class="muted measure">{components.intro}</p>}
      <div class="components">
        <div class="components__cell" data-reveal>
          <Logo />
        </div>
        <div class="components__cell" data-reveal>
          <a class="btn" href={url('/book/')}>{components.primaryButton} <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href={url('/design/')}><Icon name="phone" /> {components.secondaryButton}</a>
          <a class="link-arrow" href={url('/design/')}>{components.textLink} <Icon name="arrow-right" /></a>
        </div>
        <div class="components__cell components__cell--radii" data-reveal>
          <span style="border-radius:var(--r-lg)">28</span><span style="border-radius:var(--r-md)">18</span><span style="border-radius:var(--r-sm)">12</span><span style="border-radius:var(--pill)">pill</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{motion.title}</h2>
      {motion.intro && <p class="muted measure">{motion.intro}</p>}
      <dl class="motion">
        {motion.items.map((m) => (
          <div data-reveal>
            <dt>{m.name}</dt>
            <dd><p>{m.why}</p><p class="muted">{m.how}</p></dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section block">
    <div class="wrap">
      <h2>{inspiration.title}</h2>
      {inspiration.intro && <p class="muted measure">{inspiration.intro}</p>}
      <ul class="refs">
        {inspiration.items.map((r) => (
          <li data-reveal>
            <a href={r.url || undefined} rel="noopener">
              <span class="refs__who"><strong>{r.who}</strong>{r.where && <span class="muted">{r.where}</span>}</span>
              <span class="refs__title">{r.title} <Icon name="arrow-up-right" /></span>
              {r.took && <span class="muted refs__took">{r.took}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .head .lede { margin-top: 1.25rem; max-width: 56ch; }
  .block { border-top: 1px solid var(--line); padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .block h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .principles { list-style: none; padding: 0; display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1rem; margin-top: 2rem; }
  .principles li { background: var(--surface); border-radius: var(--r-md); padding: 1.75rem; display: grid; gap: 0.5rem; align-content: start; }
  .principles li:first-child { background: var(--bloom); color: var(--bloom-ink); }
  .principles li:first-child .muted { color: color-mix(in oklab, var(--bloom-ink) 78%, transparent); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr)); gap: 1.5rem 1rem; margin-top: 2rem; }
  .swatch { display: grid; gap: 0.3rem; align-content: start; }
  .swatch__chips { display: grid; grid-template-columns: 1fr 1fr; height: 96px; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); margin-bottom: 0.5rem; }
  .swatch code, .specimen__meta code { font-family: var(--font-text); font-weight: 600; font-size: var(--step--1); color: var(--accent); } /* two families only: no browser monospace */
  .swatch__hex { font-size: var(--step--1); }
  .swatch p { font-size: var(--step--1); }
  .specimen { margin-top: 2rem; display: grid; }
  .specimen__row { display: grid; grid-template-columns: 9rem 1fr; gap: 1.5rem; align-items: baseline; padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .specimen__meta { display: grid; font-size: var(--step--1); }
  .specimen__text { font-family: var(--font-display); font-weight: 560; letter-spacing: -0.025em; line-height: 1.05; }
  .specimen__text--body { font-family: var(--font-text); font-weight: 400; letter-spacing: 0; line-height: 1.5; }
  .components { display: grid; grid-template-columns: 1fr 2fr 1.2fr; gap: 1rem; margin-top: 2rem; }
  .components__cell { background: var(--surface); border-radius: var(--r-md); padding: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  .components__cell--radii span { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; background: var(--bg-2); border: 1px solid var(--line); font-size: var(--step--1); font-weight: 600; }
  .motion { display: grid; margin-top: 2rem; }
  .motion div { display: grid; grid-template-columns: 14rem 1fr; gap: 1.5rem; padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .motion dt { font-weight: 600; }
  .motion dd { display: grid; gap: 0.25rem; }
  .refs { list-style: none; padding: 0; margin-top: 2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .refs a { display: grid; gap: 0.6rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--r-md); text-decoration: none; height: 100%; transition: background-color 0.3s, border-color 0.3s; }
  .refs a:hover { background: var(--surface); border-color: var(--ink-2); }
  .refs__who { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--step--1); }
  .refs__title { font-family: var(--font-display); font-size: var(--step-1); font-weight: 560; letter-spacing: -0.01em; display: flex; gap: 0.4rem; align-items: center; }
  .refs__took { font-size: var(--step--1); }
  @media (max-width: 860px) {
    .principles, .components, .refs { grid-template-columns: 1fr; }
    .specimen__row, .motion div { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
