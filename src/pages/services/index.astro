---
import { url } from '../../lib/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Services" description="Check-ups, kids’ dentistry, nervous patients, fillings and crowns, emergency care, clear aligners and whitening in Sellwood, Portland.">
  <section class="head">
    <div class="wrap">
      <h1 data-split>Everything a family needs, in one place.</h1>
      <p class="lede" data-reveal>From a first visit at age one to a crown at seventy. Every price below is the full price.</p>
    </div>
  </section>

  <section class="section grid-section">
    <div class="wrap cards">
      {services.map((s, i) => (
        <a href={url(`/services/${s.id}/`)} class={`card card--${i}`} data-reveal>
          <div class="frame card__img"><Image src={s.data.photo} alt={s.data.photoAlt} width={i === 0 || i === 6 ? 1100 : 640} height={640} /></div>
          <div class="card__body">
            <h2 class="card__title"><Icon name={s.data.icon} /> {s.data.title}</h2>
            <p class="muted">{s.data.summary}</p>
            <p class="card__price">{s.data.price.split('.')[0]}.</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaBand title="Not sure what you need?" body="Call June and describe what is going on. She will tell you which appointment to book and what it costs." />
</Base>

<style>
  .head { padding-block: clamp(2rem, 1rem + 4vw, 5rem) 0; }
  .head h1 { max-width: 14ch; font-size: var(--step-5); }
  .head .lede { margin-top: 1.5rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 1rem + 2vw, 3rem) clamp(1rem, 0.5rem + 1.5vw, 2rem); }
  .card--0, .card--6 { grid-column: span 2; }
  .card { text-decoration: none; display: grid; gap: 1.1rem; align-content: start; }
  .card__img { aspect-ratio: 4 / 3; }
  .card--0 .card__img, .card--6 .card__img { aspect-ratio: auto; height: 100%; max-height: 460px; min-height: 300px; }
  .card__img :global(img) { transition: transform 0.9s var(--ease-out); }
  .card:hover .card__img :global(img) { transform: scale(1.04); }
  .card__body { display: grid; gap: 0.5rem; }
  .card__title { font-size: var(--step-2); display: flex; align-items: center; gap: 0.5rem; transition: color 0.3s; }
  .card__title :global(svg) { color: var(--accent); flex: none; }
  .card:hover .card__title { color: var(--accent); }
  .card__price { font-size: var(--step--1); font-weight: 600; }
  @media (max-width: 960px) {
    .cards { grid-template-columns: 1fr 1fr; }
    .card--0, .card--6 { grid-column: span 2; }
  }
  @media (max-width: 600px) {
    .cards { grid-template-columns: 1fr; }
    .card--0, .card--6 { grid-column: auto; }
    .card--0 .card__img, .card--6 .card__img { aspect-ratio: 4 / 3; min-height: 0; }
  }
</style>
